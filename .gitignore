.prompt-logs/
.memory.jsonl

# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/

# MCP / tool artifacts
.playwright-mcp/

# models (keep models/README.md)
models/*
!models/README.md
*.gguf
*.bin

# editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# local secrets / backups
.env
*.local.json
*.bak

# generated from mcp.json by app/prepare-mcp.py
app/.mcp.resolved.json
